# Secrets locaux : copier ce fichier vers .env (jamais committer .env)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Données HATVP : produites localement via Docker tricoteuses-hatvp.
# Aucun clone local, Node.js ou npm n'est nécessaire.
TRICOTEUSES_DATA_DIR=./data/tricoteuses
TRICOTEUSES_IMAGE=git.tricoteuses.fr/logiciels/tricoteuses-hatvp:latest

# Décisions publiques Tricoteuses / Canutes-Légifrance.
TRICOTEUSES_DECISIONS_API_URL=https://db.code4code.eu/canutes_legifrance/texte
TRICOTEUSES_DECISIONS_API_TOKEN=
TRICOTEUSES_DECISIONS_FROM_YEAR=2018
TRICOTEUSES_DECISIONS_PAGE_SIZE=1000

# Optionnel : chemins personnalisés
# TRICOTEUSES_DECISIONS_FILE=./data/decisions/decisions.parquet
# LOBBYSEARCH_ARTIFACTS_DIR=./artifacts
